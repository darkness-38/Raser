{
  "name": "raser",
  "version": "1.0.0",
  "main": "src/main/main.js",
  "bin": {
    "raser": "src/main/cli.js",
    "riff": "src/main/cli.js"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "keywords": [
    "music",
    "audio-player",
    "youtube-music",
    "soundcloud",
    "material-design",
    "desktop-app",
    "offline-music",
    "equalizer",
    "discord-rpc"
  ],
  "author": "Betül Daşdemir",
  "license": "MIT",
  "description": "A high-performance, modern, telemetry-free desktop music player with Material Design.",
  "devDependencies": {
    "electron": "^42.11.16",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "cfonts": "^3.3.1",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.7.1",
    "tone": "^15.1.22"
  },
  "productName": "Raser",
  "homepage": "https://github.com/darkness-38/Raser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkness-38/Raser.git"
  },
  "bugs": {
    "url": "https://github.com/darkness-38/Raser/issues"
  },
  "build": {
    "appId": "io.github.darkness38.raser",
    "productName": "Raser",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo"
    },
    "mac": {
      "icon": "assets/icon-1024.png",
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "darkness-38",
        "repo": "Raser",
        "releaseType": "release"
      }
    ],
    "afterPack": "scripts/mac-adhoc-sign.js"
  }
}
